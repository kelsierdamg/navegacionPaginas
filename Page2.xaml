<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="navegacionPaginas.Page2">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="¿Quién es Saúl Goodman?"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                SemanticProperties.Description="acerca de" />

            <Label
                Text="Saúl Goodman es un abogado carismático y astuto conocido por su enfoque poco convencional y a menudo cuestionable en la práctica legal. En 'Better Call Saul', se explora su transformación de un abogado con buenas intenciones a un defensor de criminales, mostrando su lucha por encontrar su identidad y éxito en el mundo legal mientras enfrenta desafíos personales y profesionales."
                Style="{StaticResource Body}"
                SemanticProperties.Description="descripción acerca de saul goodman" />

            <Button
                x:Name="RegresarBtn"
                Text="Regresar a Inicio"
                Clicked="BackBtn"
                HorizontalOptions="Center"
                SemanticProperties.Hint="Regresa a la página principal" />

        </VerticalStackLayout>
       
    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="navegacionPaginas.Page3">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Label
                Text="Teléfono"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                SemanticProperties.Description="tlfn" />

            <Label
                Text="Para consultas legales, llame al (505) 555-1234. Disponible las 24 horas del día, los 7 días de la semana."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.Description="descripción tlfn" />

            <Button
                x:Name="RegresarBtn"
                Text="Regresar a Inicio"
                Clicked="BackBtn"
                HorizontalOptions="Center"
                SemanticProperties.Hint="Regresa a la página principal" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>